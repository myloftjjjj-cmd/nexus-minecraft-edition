# Nexus MC Edition Environment Configuration
# Copy this file to .env and provide your credentials if connecting external services

# Optional Gemini API Key for extended cloud AI reasoning (server-side / build-time)
VITE_GEMINI_API_KEY=

# Optional Supabase credentials for cloud authentication & cross-device sync
# If omitted or left empty, Nexus MC Edition runs in local offline Demo Mode
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
